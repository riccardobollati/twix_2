{
  "adapter_contract": "adapt(raw) -> TWIX canonical records/nodes",
  "canonical_representation": "one physical-page record containing one areas table node; rows remain in printed order",
  "source_fields": [
    {"path": "document.source_file", "disposition": "provenance", "target": null, "conversion": "not scored; recorded in run log"},
    {"path": "document.publication", "disposition": "out_of_scope_metadata", "target": null, "conversion": "repeated page-frame metadata"},
    {"path": "document.section", "disposition": "out_of_scope_metadata", "target": null, "conversion": "repeated page-frame metadata"},
    {"path": "document.title.it", "disposition": "out_of_scope_metadata", "target": null, "conversion": "repeated page-frame metadata"},
    {"path": "document.title.en", "disposition": "out_of_scope_metadata", "target": null, "conversion": "repeated page-frame metadata"},
    {"path": "document.publisher", "disposition": "out_of_scope_metadata", "target": null, "conversion": "repeated page-frame metadata"},
    {"path": "document.airac_effective_date", "disposition": "out_of_scope_metadata", "target": null, "conversion": "repeated page-frame metadata"},
    {"path": "document.airac_amendment", "disposition": "out_of_scope_metadata", "target": null, "conversion": "repeated page-frame metadata"},
    {"path": "document.page_count", "disposition": "provenance", "target": null, "conversion": "run-level count"},
    {"path": "document.area_count", "disposition": "provenance", "target": null, "conversion": "candidate row count"},
    {"path": "pages[].page_number", "disposition": "provenance", "target": "records[].record_id", "conversion": "local page mapped through printed page_label"},
    {"path": "pages[].page_label", "disposition": "provenance", "target": "records[].record_id", "conversion": "terminal integer becomes physical source page"},
    {"path": "pages[].area_ids", "disposition": "derived", "target": null, "conversion": "duplicate index of areas[].identification; not double-scored"},
    {"path": "areas[].identification", "disposition": "mapped", "target": "Identification", "conversion": "string"},
    {"path": "areas[].name", "disposition": "mapped", "target": "Name", "conversion": "null becomes empty printed cell"},
    {"path": "areas[].lateral_limits.text", "disposition": "mapped", "target": "Lateral limits", "conversion": "string"},
    {"path": "areas[].lateral_limits.shape", "disposition": "derived", "target": null, "conversion": "derived from Lateral limits; excluded to avoid duplicate weighting"},
    {"path": "areas[].lateral_limits.description", "disposition": "derived", "target": null, "conversion": "substring of Lateral limits; excluded to avoid duplicate weighting"},
    {"path": "areas[].lateral_limits.radius_nm", "disposition": "derived", "target": null, "conversion": "parsed from Lateral limits; excluded to avoid duplicate weighting"},
    {"path": "areas[].lateral_limits.centre", "disposition": "derived", "target": null, "conversion": "parsed from Lateral limits; excluded to avoid duplicate weighting"},
    {"path": "areas[].lateral_limits.points", "disposition": "derived", "target": null, "conversion": "parsed from Lateral limits; excluded to avoid duplicate weighting"},
    {"path": "areas[].upper_limit.text", "disposition": "mapped", "target": "Upper limit", "conversion": "string"},
    {"path": "areas[].upper_limit.value", "disposition": "derived", "target": null, "conversion": "parsed from Upper limit"},
    {"path": "areas[].upper_limit.unit", "disposition": "derived", "target": null, "conversion": "parsed from Upper limit"},
    {"path": "areas[].upper_limit.reference", "disposition": "derived", "target": null, "conversion": "parsed from Upper limit"},
    {"path": "areas[].lower_limit.text", "disposition": "mapped", "target": "Lower limit", "conversion": "string"},
    {"path": "areas[].lower_limit.value", "disposition": "derived", "target": null, "conversion": "parsed from Lower limit"},
    {"path": "areas[].lower_limit.unit", "disposition": "derived", "target": null, "conversion": "parsed from Lower limit"},
    {"path": "areas[].lower_limit.reference", "disposition": "derived", "target": null, "conversion": "parsed from Lower limit"},
    {"path": "areas[].type_of_activity.text", "disposition": "mapped", "target": "Type of activity", "conversion": "string"},
    {"path": "areas[].type_of_activity.it", "disposition": "derived", "target": null, "conversion": "substring of Type of activity"},
    {"path": "areas[].type_of_activity.en", "disposition": "derived", "target": null, "conversion": "substring of Type of activity"},
    {"path": "areas[].remarks.text", "disposition": "mapped", "target": "Remarks", "conversion": "string"},
    {"path": "areas[].remarks.it", "disposition": "derived", "target": null, "conversion": "substring of Remarks"},
    {"path": "areas[].remarks.en", "disposition": "derived", "target": null, "conversion": "substring of Remarks"},
    {"path": "areas[].validity", "disposition": "mapped", "target": "Validity", "conversion": "null becomes empty printed cell"},
    {"path": "areas[].pages", "disposition": "provenance", "target": "records[].record_id", "conversion": "first local page mapped to source physical page"}
  ],
  "silent_drops": []
}
