# Vision model used for template inference, routing, and ground truth.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Codex models used to generate and repair Python extraction code.
CODEX_MODEL=gpt-5.4
CODEX_EASY_MODEL=gpt-5.4-mini
CODEX_HARD_MODEL=gpt-5.4

# Azure alternative (set LLM_PROVIDER=azure).
# AZURE_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
