# OpenRouter is used for all model calls, including held-out ground truth.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_GROUND_TRUTH_MODEL=openai/gpt-5.4
OPENROUTER_GROUND_TRUTH_MAX_TOKENS=128000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_TEMPLATE_INFERENCE_MODEL=openai/gpt-5.4
OPENROUTER_TEMPLATE_INFERENCE_REASONING_EFFORT=low
OPENROUTER_APP_NAME=TWIX 2
# OPENROUTER_APP_URL=https://your-project.example

# OpenCode models used to generate and repair Python extraction code. The hard
# model also generates block separation and classifies block difficulty through
# a direct OpenRouter call.
# OpenCode model IDs must use provider/model form.
OPENCODE_MODEL=openrouter/deepseek/deepseek-v4-flash
OPENCODE_EASY_MODEL=openrouter/deepseek/deepseek-v4-flash
OPENCODE_HARD_MODEL=openrouter/deepseek/deepseek-v4-pro

# Other supported OpenRouter model IDs:
# Direct/reference: deepseek/deepseek-v4.1-flash, z-ai/glm-5.3-flash,
#                   qwen/qwen3.8-flash
# OpenCode: openrouter/deepseek/deepseek-v4.1-flash,
#           openrouter/z-ai/glm-5.3-flash, openrouter/qwen/qwen3.8-flash
